---
import DocsLayout from "@/layouts/docs.astro"

const heroStats = [
  { value: "141", label: "TOML filter rules across 40 files" },
  { value: "40", label: "Dedicated JSON/structured parsers" },
  { value: "144K / 171K", label: "ig vs rtk total bytes (21 cases, v2.3.0)" },
  { value: "-84%", label: "ig signature reads vs rtk (2.3K vs 14.8K)" },
]

const benchV230 = [
  { cat: "search", label: "literal: fn main",      igB: 2858,  igMs: 112,  rtkB: 3128,  rtkMs: 111 },
  { cat: "search", label: "regex: impl.*Display",   igB: 29,    igMs: 111,  rtkB: 29,    rtkMs: 117 },
  { cat: "search", label: "count: pub fn",          igB: 1682,  igMs: 114,  rtkB: 1,     rtkMs: 112, note: "rtk -c unsupported" },
  { cat: "search", label: "files-only: todo",       igB: 198,   igMs: 114,  rtkB: 0,     rtkMs: 111, note: "rtk -l unsupported" },
  { cat: "search", label: "--top 5: filter",        igB: 2553,  igMs: 109,  rtkB: 16088, rtkMs: 111, moat: true },
  { cat: "search", label: "--semantic: error",       igB: 2291,  igMs: 111,  rtkB: 16384, rtkMs: 111, moat: true },
  { cat: "read",   label: "full: main.rs",          igB: 80476, igMs: 111,  rtkB: 69130, rtkMs: 114, note: "ig keeps line-number prefix" },
  { cat: "read",   label: "sigs: main.rs",          igB: 2354,  igMs: 112,  rtkB: 14833, rtkMs: 109, moat: true },
  { cat: "read",   label: "full: pipeline.rs",      igB: 15005, igMs: 111,  rtkB: 12509, rtkMs: 111, note: "ig keeps line-number prefix" },
  { cat: "read",   label: "sigs: pipeline.rs",      igB: 1849,  igMs: 112,  rtkB: 3989,  rtkMs: 109, moat: true },
  { cat: "smart",  label: "smart: src/filter/",     igB: 36,    igMs: 109,  rtkB: 0,     rtkMs: 109, note: "rtk smart dir unsupported" },
  { cat: "smart",  label: "smart: src/",            igB: 149,   igMs: 110,  rtkB: 0,     rtkMs: 110, note: "rtk smart dir unsupported" },
  { cat: "listing",label: "ls: root",               igB: 314,   igMs: 110,  rtkB: 286,   rtkMs: 109 },
  { cat: "listing",label: "ls: src/",               igB: 576,   igMs: 111,  rtkB: 548,   rtkMs: 110 },
  { cat: "git",    label: "git status",             igB: 253,   igMs: 110,  rtkB: 271,   rtkMs: 111 },
  { cat: "git",    label: "git log",                igB: 923,   igMs: 110,  rtkB: 1270,  rtkMs: 110 },
  { cat: "git",    label: "git diff",               igB: 6662,  igMs: 111,  rtkB: 5233,  rtkMs: 111 },
  { cat: "tools",  label: "env",                    igB: 3346,  igMs: 111,  rtkB: 1026,  rtkMs: 110 },
  { cat: "tools",  label: "deps",                   igB: 397,   igMs: 109,  rtkB: 256,   rtkMs: 109 },
  { cat: "tools",  label: "json: Cargo.toml",       igB: 0,     igMs: 109,  rtkB: 0,     rtkMs: 109 },
  { cat: "tools",  label: "diff: 2 files",          igB: 22296, igMs: 110,  rtkB: 25745, rtkMs: 109 },
]

const coverageComparison = [
  { category: "Test runners",     ig: "jest, vitest, playwright, pytest, cargo test, go test, rspec, rake, phpunit, pest, cypress, bun test", igCount: 12, rtk: "jest, vitest, playwright, pytest, cargo test, go test, rspec, rake", rtkCount: 8 },
  { category: "Lint / format",    ig: "eslint, biome, tsc, prettier, ruff, mypy, rubocop, golangci-lint, shellcheck, yamllint, markdownlint, hadolint, pre-commit, trunk, black, cargo clippy", igCount: 16, rtk: "eslint, biome, tsc, prettier, ruff, golangci-lint, rubocop", rtkCount: 7 },
  { category: "Build",            ig: "cargo build, next build, make, mvn, swift, mix, dotnet build", igCount: 7, rtk: "cargo build, next build", rtkCount: 2 },
  { category: "Containers / K8s", ig: "docker (9 rules), kubectl (9 rules), helm (5 rules)", igCount: 23, rtk: "docker (4), kubectl (3)", rtkCount: 7 },
  { category: "Cloud / IaC",      ig: "aws (4+4), gcloud, terraform (4), ansible (3), tofu, systemctl", igCount: 18, rtk: "aws (8)", rtkCount: 8 },
  { category: "Package managers",  ig: "npm, pnpm, pip, poetry, uv, composer, brew, bundle", igCount: 8, rtk: "pnpm, pip, bundle, prisma", rtkCount: 4 },
  { category: "Git platforms",    ig: "gh, glab, gt (Graphite)", igCount: 3, rtk: "gh", rtkCount: 1 },
  { category: "System / network", ig: "wc, curl, wget, env, tree, diff, df, du, ps, rsync, ping, log, summary", igCount: 13, rtk: "curl, wget, env, tree", rtkCount: 4 },
  { category: "Monorepo",         ig: "nx, turbo", igCount: 2, rtk: "—", rtkCount: 0 },
  { category: ".NET / Elixir / Swift / Java", ig: "dotnet (4), mix, swift, mvn", igCount: 4, rtk: "—", rtkCount: 0 },
]

const features = [
  { feature: "Trigram-indexed search engine",        ig: "Yes",             rtk: "No (wraps rg)",   moat: true },
  { feature: "BM25 --top N ranking",                 ig: "Yes",             rtk: "No (no index)",   moat: true },
  { feature: "--semantic PMI query expansion",       ig: "Yes",             rtk: "No (no index)",   moat: true },
  { feature: "IDF-weighted sparse n-grams",          ig: "Yes",             rtk: "No",              moat: true },
  { feature: "Bloom + locMask (3.5-gram)",           ig: "Yes",             rtk: "No",              moat: true },
  { feature: "ig read -s / smart / symbols / pack",  ig: "Yes",             rtk: "File-only smart", moat: true },
  { feature: "Budget mode (entropy-scored)",         ig: "Yes",             rtk: "No",              moat: true },
  { feature: "Relevance boost (-r)",                 ig: "Yes",             rtk: "No",              moat: true },
  { feature: "Delta reads (git changes)",            ig: "Yes",             rtk: "No",              moat: true },
  { feature: "grep -c / -l / -i flags",             ig: "All supported",   rtk: "Not supported",   moat: true },
  { feature: "Directory-level smart summaries",      ig: "Yes",             rtk: "File-only",       moat: true },
  { feature: "TOML filter rules",                    ig: "141 rules",       rtk: "Not disclosed",   moat: null },
  { feature: "Dedicated structured parsers",         ig: "40 parsers",      rtk: "Not disclosed",   moat: null },
  { feature: "Command-output filter wrappers",       ig: "40+ wrappers",   rtk: "100+ claimed",    moat: null },
  { feature: "0/1/2/3 hook exit-code protocol",      ig: "Yes",             rtk: "Yes",             moat: null },
  { feature: "Permission engine (deny / ask)",       ig: "Yes",             rtk: "Yes",             moat: null },
  { feature: "RTK filter import",                    ig: "ig import-rtk",   rtk: "—",               moat: null },
  { feature: "Agent setup / hook install",           ig: "11 agents",       rtk: "14 platforms",    moat: null, rtkAdvantage: true },
  { feature: "Token savings dashboard",              ig: "ig gain",         rtk: "rtk gain",        moat: null },
  { feature: "Git output compression",               ig: "Yes",             rtk: "Yes",             moat: null },
  { feature: "ls / tree compression",                ig: "Yes",             rtk: "Yes",             moat: null },
  { feature: "Process-per-invocation (no daemon)",   ig: "Yes",             rtk: "Yes",             moat: null },
]
---

<DocsLayout title="ig vs RTK" description="ig v2.3.0 vs rtk 0.42.2 — real benchmark, filter coverage audit, and the index moat.">
  <div class="max-w-none">
    <!-- Page header -->
    <div class="mb-10">
      <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest mb-3 text-muted-foreground">
        <span>ig v2.3.0 vs rtk 0.42.2 — 2026-06-05</span>
      </div>
      <h1 class="text-3xl font-semibold mb-4">
        ig vs RTK
      </h1>
      <p class="text-muted-foreground text-lg leading-relaxed">
        <code class="font-mono text-sm">ig</code> ships <strong>141 TOML filter rules</strong> and
        <strong>40 dedicated structured parsers</strong> — broader coverage than
        <a href="https://github.com/rtk-ai/rtk" class="underline">rtk</a>'s claimed "100+ commands",
        <strong>plus</strong> a trigram-indexed search engine rtk does not have.
        On a real benchmark, ig emits <strong>15.5% fewer bytes</strong> at identical speed.
      </p>
    </div>

    <!-- Hero Stats -->
    <section class="mb-12">
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
        {heroStats.map((stat) => (
          <div class="text-center p-5 rounded-lg border">
            <div class="text-2xl font-semibold mb-1">{stat.value}</div>
            <div class="text-xs text-muted-foreground">{stat.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 1: Filter Coverage Comparison -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">Filter Coverage — ig vs RTK</h2>
      <p class="text-sm text-muted-foreground mb-5 leading-relaxed">
        Audited 2026-06-05. ig covers <strong>90+ unique tools</strong> across 40 TOML filter files (141 rules) and 40 dedicated JSON/structured parsers.
        RTK claims "100+ commands" but documents ~63. ig has significantly more coverage in IaC, containers, lint, PHP, .NET, monorepo, and system tools.
      </p>

      <div class="overflow-x-auto border rounded-lg overflow-hidden">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-muted">
              <th class="text-left py-3 px-4 text-xs text-muted-foreground font-normal uppercase tracking-wider">Category</th>
              <th class="text-right py-3 px-4 text-xs font-normal uppercase tracking-wider">ig</th>
              <th class="text-right py-3 px-4 text-xs text-muted-foreground font-normal uppercase tracking-wider">rtk</th>
            </tr>
          </thead>
          <tbody class="text-xs">
            {coverageComparison.map((row) => (
              <tr class="border-t hover:bg-muted/50">
                <td class="py-3 px-4 font-semibold">{row.category}</td>
                <td class={`py-3 px-4 text-right ${row.igCount > row.rtkCount ? "font-semibold" : "text-muted-foreground"}`}>{row.igCount}</td>
                <td class={`py-3 px-4 text-right ${row.rtkCount > row.igCount ? "font-semibold" : "text-muted-foreground"}`}>{row.rtkCount}</td>
              </tr>
            ))}
            <tr class="border-t bg-muted/30">
              <td class="py-3 px-4 font-semibold">Total</td>
              <td class="py-3 px-4 text-right font-semibold">106</td>
              <td class="py-3 px-4 text-right text-muted-foreground">41</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-xs text-muted-foreground mt-3">
        Count = distinct tool/subcommand entries. ig's total is verifiable: <code>grep -c '\[\[filters\]\]' filters/*.toml</code> → 141 rules.
        RTK's internals are not disclosed.
      </p>
    </section>

    <!-- Section 2: Real Benchmark -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">Real Benchmark — 21 Cases</h2>
      <p class="text-sm text-muted-foreground mb-5 leading-relaxed">
        Benchmark run on the instant-grep codebase itself (~90 Rust source files).
        ig v2.3.0 vs rtk 0.42.2, Linux x86_64, ripgrep 15.1.0. Each command timed with <code>date +%s%N</code>, output measured with <code>wc -c</code>.
      </p>

      <div class="overflow-x-auto border rounded-lg overflow-hidden">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-muted">
              <th class="text-left py-3 px-4 text-xs text-muted-foreground font-normal uppercase tracking-wider">Category</th>
              <th class="text-left py-3 px-4 text-xs text-muted-foreground font-normal uppercase tracking-wider">Command</th>
              <th class="text-right py-3 px-4 text-xs font-normal uppercase tracking-wider">ig bytes</th>
              <th class="text-right py-3 px-4 text-xs text-muted-foreground font-normal uppercase tracking-wider">rtk bytes</th>
              <th class="text-left py-3 px-4 text-xs text-muted-foreground font-normal uppercase tracking-wider">Note</th>
            </tr>
          </thead>
          <tbody class="text-xs">
            {benchV230.map((row) => {
              const igWins = row.igB < row.rtkB
              const rtkWins = row.rtkB < row.igB
              return (
                <tr class={`border-t hover:bg-muted/50 ${row.moat ? "bg-muted/30" : ""}`}>
                  <td class="py-2.5 px-4 text-muted-foreground">{row.cat}</td>
                  <td class="py-2.5 px-4">
                    {row.label}
                    {row.moat && <span class="ml-2 text-[10px] font-mono uppercase tracking-wider text-muted-foreground">moat</span>}
                  </td>
                  <td class={`py-2.5 px-4 text-right ${igWins ? "font-semibold" : "text-muted-foreground"}`}>
                    {row.igB.toLocaleString()}
                  </td>
                  <td class={`py-2.5 px-4 text-right ${rtkWins ? "font-semibold" : "text-muted-foreground"}`}>
                    {row.rtkB.toLocaleString()}
                  </td>
                  <td class="py-2.5 px-4 text-muted-foreground text-[10px]">{row.note || ""}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>

      <div class="grid sm:grid-cols-2 gap-4 mt-6">
        <div class="p-5 rounded-lg border">
          <h3 class="font-semibold mb-2">Aggregate Totals</h3>
          <div class="text-sm text-muted-foreground space-y-1">
            <p>ig total bytes: <strong class="text-foreground">144,247</strong></p>
            <p>rtk total bytes: <span>170,726</span></p>
            <p>ig total time: <strong class="text-foreground">2,327 ms</strong></p>
            <p>rtk total time: <span>2,323 ms</span></p>
          </div>
        </div>
        <div class="p-5 rounded-lg border">
          <h3 class="font-semibold mb-2">Summary</h3>
          <div class="text-sm text-muted-foreground space-y-1">
            <p><strong class="text-foreground">ig emits 15.5% fewer bytes</strong> at identical speed (~110ms/cmd).</p>
            <p>The moat rows (<code>--top</code>, <code>--semantic</code>, signatures) drive the aggregate advantage: <strong>80-86% byte reduction</strong> on queries RTK cannot rank or expand.</p>
          </div>
        </div>
      </div>

      <p class="text-xs text-muted-foreground mt-3">
        Raw CSV: <a href="/bench/v2.3.0/results.csv">results.csv</a>, <a href="/bench/v2.3.0/summary.md">summary.md</a>.
        Previous benchmark (v1.10.0, 115 cases): <a href="/bench/v1.10.0/results.csv">results.csv</a>, <a href="/bench/v1.10.0/summary.md">summary.md</a>.
      </p>
    </section>

    <!-- Section 3: The Index Moat -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">The Index Moat</h2>
      <p class="text-sm text-muted-foreground mb-5 leading-relaxed">
        rtk is a generic output-compression proxy: it shells to <code>rg</code>, <code>git</code>, <code>find</code>... and compresses their output.
        ig is a <em>search engine</em> with a persistent index — which unlocks capabilities rtk cannot match without completely redesigning itself.
      </p>

      <div class="grid sm:grid-cols-2 gap-4">
        <div class="p-5 rounded-lg border">
          <h3 class="font-semibold mb-2">--top N (BM25 ranking)</h3>
          <p class="text-sm text-muted-foreground mb-3">
            Score each matched file by Okapi BM25 and return only the top N. rtk has no <code>tf</code> / <code>df</code> / <code>avdl</code> so it cannot rank — it can only cap flat output length.
          </p>
          <pre class="text-[11px] font-mono bg-muted p-3 rounded overflow-x-auto">
<span class="text-muted-foreground">ig --top 5 "filter"</span>
<span class="font-semibold">  →  2,553 B</span>

<span class="text-muted-foreground">rtk grep "filter"</span>
  →  16,088 B   <span class="text-muted-foreground">(-84%)</span></pre>
        </div>

        <div class="p-5 rounded-lg border">
          <h3 class="font-semibold mb-2">Signature reads (-s)</h3>
          <p class="text-sm text-muted-foreground mb-3">
            ig extracts imports + function signatures. rtk strips bodies but keeps far more noise. The gap widens on large files.
          </p>
          <pre class="text-[11px] font-mono bg-muted p-3 rounded overflow-x-auto">
<span class="text-muted-foreground">ig read src/main.rs -s</span>
<span class="font-semibold">  →  2,354 B</span>

<span class="text-muted-foreground">rtk read src/main.rs -l aggressive</span>
  →  14,833 B   <span class="text-muted-foreground">(-84%)</span></pre>
        </div>
      </div>
    </section>

    <!-- Section 4: RTK Functional Gaps -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">RTK Functional Gaps</h2>
      <p class="text-sm text-muted-foreground mb-5 leading-relaxed">
        Verified on rtk 0.42.2 (2026-06-05). These are features ig supports that rtk does not.
      </p>

      <ul class="text-sm text-muted-foreground space-y-3 leading-relaxed">
        <li>
          <strong><code>grep -c</code> (count per file)</strong> — rtk returns "0" regardless of actual match count.
        </li>
        <li>
          <strong><code>grep -l</code> (files-with-matches)</strong> — rtk returns empty output.
        </li>
        <li>
          <strong><code>smart</code> on directories</strong> — rtk fails with "Is a directory". ig supports directory-level summaries.
        </li>
        <li>
          <strong><code>symbols</code>, <code>context</code>, <code>pack</code></strong> — ig-only capabilities with no rtk equivalent.
        </li>
      </ul>
    </section>

    <!-- Section 5: Where rtk still wins -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">Where rtk Still Wins</h2>

      <ul class="text-sm text-muted-foreground space-y-3 leading-relaxed">
        <li>
          <strong>Platform integrations (14 vs 3).</strong> rtk supports Cursor, GitHub Copilot, Windsurf, Cline, and other editors out of the box. ig currently targets Claude Code, Codex, and Gemini CLI.
        </li>
        <li>
          <strong>Full file reads (~15% smaller).</strong> ig keeps the <code>   42: content</code> line-number prefix because it's what lets the Edit tool round-trip precisely. rtk drops it — fewer bytes, less precision.
        </li>
        <li>
          <strong>env / deps compression.</strong> rtk's env filter is more aggressive (1.0K vs 3.3K). ig's filter prioritizes security (credential masking) over raw byte count.
        </li>
      </ul>
    </section>

    <!-- Section 6: Feature Comparison -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">Feature Comparison</h2>

      <div class="overflow-x-auto border rounded-lg overflow-hidden">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-muted">
              <th class="text-left py-3 px-4 text-xs text-muted-foreground font-normal uppercase tracking-wider">Feature</th>
              <th class="text-center py-3 px-4 text-xs font-normal uppercase tracking-wider">ig</th>
              <th class="text-center py-3 px-4 text-xs text-muted-foreground font-normal uppercase tracking-wider">rtk</th>
            </tr>
          </thead>
          <tbody class="text-xs">
            {features.map((row) => (
              <tr class={`border-t hover:bg-muted/50 ${row.moat ? "bg-muted/30" : ""}`}>
                <td class="py-3 px-4">
                  {row.feature}
                  {row.moat === true && <span class="ml-2 text-[10px] font-mono uppercase tracking-wider text-muted-foreground">moat</span>}
                </td>
                <td class={`py-3 px-4 text-center ${row.rtkAdvantage ? "text-muted-foreground" : "font-semibold"}`}>{row.ig}</td>
                <td class={`py-3 px-4 text-center ${row.rtkAdvantage ? "font-semibold" : "text-muted-foreground"}`}>{row.rtk}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-xs text-muted-foreground mt-3">
        <span class="font-mono uppercase tracking-wider">moat</span> rows mark structural advantages — they require a persistent index, which rtk does not have.
      </p>
    </section>

    <!-- Section 7: ig gain Dashboard mockup -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">ig gain Dashboard</h2>
      <p class="text-sm text-muted-foreground mb-5">
        Real output from <code class="font-mono">ig gain</code> — token savings tracked across all sessions.
      </p>

      <div class="rounded-lg border overflow-hidden">
        <div class="flex items-center gap-1.5 px-4 py-2.5 border-b bg-muted">
          <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#28C840]"></div>
          <span class="text-xs text-muted-foreground font-mono ml-2">ig gain</span>
        </div>
        <pre class="p-5 text-xs font-mono leading-relaxed overflow-x-auto"><span class="font-bold" style="color: oklch(0.8 0 0)">ig Token Savings</span>
<span style="color: oklch(0.4 0 0)">================================================================</span>

<span style="color: oklch(0.6 0 0)">Total commands:</span>    <span class="font-bold" style="color: oklch(0.9 0 0)">3,445</span>
<span style="color: oklch(0.6 0 0)">Input bytes:</span>       <span class="font-bold" style="color: oklch(0.9 0 0)">28.7M</span>
<span style="color: oklch(0.6 0 0)">Output bytes:</span>      <span class="font-bold" style="color: oklch(0.9 0 0)">21.4M</span>
<span style="color: oklch(0.6 0 0)">Bytes saved:</span>       <span class="font-bold" style="color: oklch(0.85 0 0)">7.3M (25.4%)</span>

<span style="color: oklch(0.5 0 0)">By Command  (top 20)</span>
<span style="color: oklch(0.3 0 0)">-----------------------------------------------------------------------</span>
<span style="color: oklch(0.4 0 0)">  #   Command                        Count    Saved    Avg%  Impact</span>
<span style="color: oklch(0.3 0 0)">-----------------------------------------------------------------------</span>
<span style="color: oklch(0.6 0 0)">  1.  ig read -s                       343     3.9M</span>  <span class="font-bold" style="color: oklch(0.85 0 0)">92.7%</span>  <span style="color: oklch(0.7 0 0)">==========</span>
<span style="color: oklch(0.6 0 0)">  2.  ig git diff                      184     1.9M</span>  <span class="font-bold" style="color: oklch(0.85 0 0)">70.6%</span>  <span style="color: oklch(0.7 0 0)">=====</span>
